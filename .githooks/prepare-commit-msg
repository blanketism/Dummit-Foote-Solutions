#!/usr/bin/env python3

import re
import subprocess
import sys
from collections import defaultdict

EXERCISE_RE = re.compile(r"\\begin\{exercise\}\*?[\{\[]([^}\]]+)[\}\]]")
UNLABELED_RE = re.compile(r"\\begin\{exercise\}\*?(?![\{\[*])")
SOL_START_RE = re.compile(r"\\begin\{(?:sol|solenum|solitem|soliff)\}")
SOL_END_RE = re.compile(r"\\end\{(?:sol|solenum|solitem|soliff)\}")
EXERCISE_END_RE = re.compile(r"\\end\{exercise\}")

ALLOWED_SOURCES = ("", "template", "message")


def _natural(s):
    return tuple((0, int(t)) if t.isdigit() else (1, t)
                 for t in re.findall(r"\d+|\D+", s))


def chapter_key(label):
    if "." in label:
        return label.split(".")[0]
    m = re.match(r"\d+|\D", label)
    return m[0] if m else label


def collect_edits(diff_text):
    found = defaultdict(set)
    current_file = current_exercise = None
    in_solution = False
    warned = set()

    for line in diff_text.splitlines():
        if line.startswith("+++ b/"):
            current_file = line[6:]
            current_exercise = None
            in_solution = False
            continue
        if line.startswith(("@@", "---", "diff ")):
            continue

        content = line[1:] if line[:1] in "+- " else line

        if UNLABELED_RE.search(content) and current_file not in warned:
            print(f"Warning: unlabeled exercise in {current_file}", file=sys.stderr)
            warned.add(current_file)

        if m := EXERCISE_RE.search(content):
            current_exercise = m[1].strip()
            in_solution = False
        elif SOL_START_RE.search(content):
            in_solution = True
        elif SOL_END_RE.search(content) or EXERCISE_END_RE.search(content):
            in_solution = False
        elif line.startswith("+") and in_solution and current_exercise:
            found[chapter_key(current_exercise)].add(current_exercise)

    return found


def build_message(found):
    chapters = sorted(found, key=_natural)
    subject = f"fix: chapter{'s' if len(chapters) > 1 else ''} {', '.join(chapters)}\n\n"
    body = "\n".join(", ".join(sorted(found[ch], key=_natural)) for ch in chapters)
    return subject + body


def main():
    msg_file = sys.argv[1]
    source = sys.argv[2] if len(sys.argv) > 2 else ""
    if source not in ALLOWED_SOURCES:
        return

    with open(msg_file, encoding="utf-8", errors="replace") as f:
        existing = [ln for ln in f.read().splitlines()
                    if ln.strip() and not ln.lstrip().startswith("#")]
    if existing:
        return

    result = subprocess.run(
        ["git", "diff", "--cached", "-U999999", "--", "*.tex"],
        capture_output=True, encoding="utf-8", errors="replace",
    )
    if result.returncode != 0:
        print(f"prepare-commit-msg: git diff failed:\n{result.stderr}", file=sys.stderr)
        return

    found = collect_edits(result.stdout)
    if found:
        with open(msg_file, "w", encoding="utf-8", newline="\n") as f:
            f.write(build_message(found))


if __name__ == "__main__":
    main()